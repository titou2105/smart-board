# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Where tasks come from: mock (sample tasks, default) | file (your real tasks in data/tasks.json)
DATA_PROVIDER=mock

# Task assistant brain: mock (free, default) | claude (paid, planned in M4)
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=claude. Server-side only, never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
